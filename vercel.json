{
  "redirects": [
    {
      "source": "/learn",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/learn/:path*",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/rubric",
      "destination": "/method/#the-index-what-it-scores",
      "permanent": true
    },
    {
      "source": "/rubric/",
      "destination": "/method/#the-index-what-it-scores",
      "permanent": true
    },
    {
      "source": "/methodology",
      "destination": "/method/#the-index-how-it-was-applied",
      "permanent": true
    },
    {
      "source": "/methodology/",
      "destination": "/method/#the-index-how-it-was-applied",
      "permanent": true
    },
    {
      "source": "/narrative/method",
      "destination": "/method/#the-map-what-it-records",
      "permanent": true
    },
    {
      "source": "/narrative/method/",
      "destination": "/method/#the-map-what-it-records",
      "permanent": true
    },
    {
      "source": "/alpha",
      "destination": "/sn/",
      "permanent": true
    },
    {
      "source": "/alpha/",
      "destination": "/sn/",
      "permanent": true
    },
    {
      "source": "/alpha/:n(\\d+)",
      "destination": "/sn/:n/#token",
      "permanent": true
    },
    {
      "source": "/alpha/:n(\\d+)/",
      "destination": "/sn/:n/#token",
      "permanent": true
    },
    {
      "source": "/narrative/sn:n(\\d+)",
      "destination": "/sn/:n/#says",
      "permanent": true
    },
    {
      "source": "/narrative/sn:n(\\d+)/",
      "destination": "/sn/:n/#says",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        }
      ]
    },
    {
      "source": "/data/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=300"
        },
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        }
      ]
    },
    {
      "source": "/assets/og/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400"
        }
      ]
    },
    {
      "source": "/favicon.svg",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800"
        }
      ]
    }
  ],
  "trailingSlash": true
}
